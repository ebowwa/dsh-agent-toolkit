#!/usr/bin/env bash
# gh-scrub-shim — the scrubber sits between the AGENT and GitHub.
#
# Installed by run-dsh-agent.sh at the FRONT of the agent's PATH: the agent's
# `gh` resolves to this shim, which runs every text-bearing argument through
# scrub-output.mjs (default mode plus DSH_SCRUB_KEEP_DATES: credentials + PII
# + IPs/hosts/paths, DATES KEPT) before exec'ing the real gh. GitHub-bound
# text (comments, PR bodies/titles, review bodies, issue bodies/titles,
# release notes, api -f fields) can then never carry a key, SSN, SSH key, IP,
# or home path past this line — while dates ride through untouched: authored
# prose legitimately carries dates, and rewriting it at POST time corrupts
# the STORED body (ebowwa/FleetTower#301 — the shim manufactured
# [redacted:date] placeholders into a PR body a review then asked the agent
# to "fill", and every fill re-manufactured them).
#
# Env contract (set by run-dsh-agent.sh; names deliberately avoid the
# KEY/PASSWORD/SECRET/TOKEN patterns dsh scrubs from child env):
#   GH_SCRUB_REAL   absolute path of the real gh
#   SCRUB_SCRIPT    absolute path of scrub-output.mjs
#
# Fail-closed (REVIEW.md): if the scrubber cannot run, this shim exits
# non-zero and the real gh is NEVER exec'd — unscrubbed text does not ride a
# scrubber outage past this line. The failure is loud (the scrubber's stderr
# passes through + one context line); the TEXT itself is never echoed, since
# it may be the secret. Shell seam: every call site captures
#   out="$(scrub_or_die ...)" || exit 1
# because a bare exit inside $( ) kills only the substitution — the status
# must reach the parent shell for the abort to land before the exec.
#
# Honest limits: an agent invoking the real binary by absolute path, or
# curl-ing api.github.com directly, bypasses the shim. Those are deliberate
# circumvention, not accidents — the review stage and trace make both visible.
# Also now covered: the `-` (stdin) spelling of the *-file flags and the
# equals-form of --body-file=/--title-file= (issue #157 gap, closed by the
# #167 guard): a `-` value has the shim read the shim's own stdin through the
# scrubber and run gh with stdin redirected from the scrubbed temp file; an
# equals-form file flag takes the same scrub_file path as the separate-arg
# spelling. Both fail closed — a scrubber failure aborts before gh runs, and
# the scrubbed temp itself is unlinked the moment gh is done (issue #154 —
# the old `exec` tail left every temp in TMPDIR for the life of the box).

set -uo pipefail
REAL="${GH_SCRUB_REAL:?gh shim: GH_SCRUB_REAL not set}"
SCRUB="${SCRUB_SCRIPT:?gh shim: SCRUB_SCRIPT not set}"

die() { echo "gh-scrub-shim: $*" >&2; exit 1; }

# Scrubbed-temp cleanup (issue #154): scrub_file/scrub_stdin mint
# "$TMPDIR/gh-scrubbed.XXXXXX" temps that gh reads at run time. The old tail
# `exec`-ed the real gh — replacing this shell — so nothing could unlink a
# temp AFTER gh read it: every --body-file/--title-file/--notes-file call
# left a copy of the post-scrub body in TMPDIR for the life of the box, and
# shared lanes accumulated a transcript of fleet posts. The shim now stays
# alive as the wrapper (see the run tail): gh runs as a child, its exit
# status is forwarded unchanged, and this trap unlinks every registered temp
# on the way out — success, abort, or signal. Registration happens in the
# PARENT shell (file_flag_value), never inside the scrub helpers: their
# callers capture them via $( ), and an array append inside a command
# substitution dies with the subshell.
GH_SCRUB_TEMPS=()
cleanup_gh_scrub_temps() {
  if [ "${#GH_SCRUB_TEMPS[@]}" -gt 0 ]; then
    rm -f "${GH_SCRUB_TEMPS[@]}"
  fi
}
trap cleanup_gh_scrub_temps EXIT
# An untrapped INT/TERM kills the shell without running the EXIT trap; route
# both through exit so the cleanup lands on Ctrl-C too.
trap 'exit 130' INT
trap 'exit 143' TERM HUP

scrub_text() { DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" <<<"$1"; }

scrub_or_die() { # <text> -> scrubbed text on stdout; aborts the shim on failure
  local out
  out="$(scrub_text "$1")" || die "scrubber failed; refusing to pass unscrubbed text onward to gh (fail-closed, REVIEW.md)"
  printf '%s' "$out"
}

scrub_file() { # <path> -> echoes a scrubbed temp file path; aborts the shim on failure
  local out
  out="$(mktemp "${TMPDIR:-/tmp}/gh-scrubbed.XXXXXX")"
  if ! DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" <"$1" >"$out"; then
    rm -f "$out"
    die "scrubber failed on $1; refusing to pass the raw file onward to gh (fail-closed, REVIEW.md)"
  fi
  printf '%s' "$out"
}

scrub_stdin() { # consumes the shim's own stdin -> scrubbed temp file path on stdout
  local out
  out="$(mktemp "${TMPDIR:-/tmp}/gh-scrubbed.XXXXXX")"
  if ! DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" >"$out"; then
    rm -f "$out"
    die "scrubber failed on stdin; refusing to pass the raw stdin payload onward to gh (fail-closed, REVIEW.md)"
  fi
  printf '%s' "$out"
}

STDIN_SCRUBBED=""

file_flag_value() { # <flag> <value> — route one *-file value: temp-scrub a real
                    # file, stdin-scrub `-`, else ride through (gh errors on it)
  local flag="$1" val="$2"
  if [ "$val" = "-" ]; then
    # gh's stdin form: scrub the payload once, keep `-` in gh's argv, and run
    # gh with stdin redirected from the scrubbed temp (see the run tail).
    STDIN_SCRUBBED="$(scrub_stdin)" || exit 1
    GH_SCRUB_TEMPS+=("$STDIN_SCRUBBED")
    args+=("$flag" "$val")
  elif [ -f "$val" ]; then
    scrubbed_file="$(scrub_file "$val")" || exit 1
    GH_SCRUB_TEMPS+=("$scrubbed_file")
    args+=("$flag" "$scrubbed_file")
  else
    args+=("$flag" "$val")
  fi
}

# value flags whose ARGUMENT is agent-authored GitHub-bound text
is_value_flag() {
  case "$1" in
    --body|--title|--message|--description|--notes|-t|-b|-n) return 0;;
    *) return 1;;
  esac
}
scrubbable_field() {
  case "$1" in
    body|title|subject|message|description|comment) return 0;;
    *) return 1;;
  esac
}

args=()
while [ $# -gt 0 ]; do
  flag="$1"; shift
  case "$flag" in
    --body=*|--title=*|--message=*|--description=*|--notes=*)
      key="${flag%%=*}"; val="${flag#*=}"
      scrubbed="$(scrub_or_die "$val")" || exit 1
      args+=("$key=$scrubbed");;
    --body-file|--title-file|--notes-file)
      if [ $# -gt 0 ]; then
        file_flag_value "$flag" "$1"
        shift
      else
        args+=("$flag")
      fi;;
    --body-file=*|--title-file=*|--notes-file=*)
      # equals-form spelling of the *-file flags (gh's parser accepts both) —
      # same routing as the separate-arg form: scrub_file for a real path,
      # stdin-scrub for `-` (issue #157 gap — used to ride the catch-all raw)
      val="${flag#*=}"
      file_flag_value "${flag%%=*}" "$val";;
    -f|-F|--raw-field|--field)
      if [ $# -gt 0 ]; then
        key="${1%%=*}"
        if scrubbable_field "$key" && [ "$1" != "$key" ]; then
          scrubbed="$(scrub_or_die "${1#*=}")" || exit 1
          args+=("$flag" "$key=$scrubbed")
        else
          args+=("$flag" "$1")
        fi
        shift
      else
        args+=("$flag")
      fi;;
    *)
      if is_value_flag "$flag" && [ $# -gt 0 ] && [ "$1" != "--" ]; then
        # These flags can never be boolean in gh's CLI, so gh consumes the
        # next argv element as the value EVEN WHEN it starts with `-` — a
        # leading-dash value used to ride the catch-all and exec raw (issue
        # #159). Consume-and-scrub it too. Only `--` is skipped: its follower
        # is a gh positional, not this flag's value. Boolean-only flags like
        # `gh pr merge -m` are untouched — -m is not a value flag here.
        scrubbed="$(scrub_or_die "$1")" || exit 1
        args+=("$flag" "$scrubbed"); shift
      else
        args+=("$flag")
      fi;;
  esac
done

# A `-` file-flag value was stdin-scrubbed: gh still receives `-` in argv, but
# reads the scrubbed temp instead of the raw payload.
#
# Run gh as a CHILD, not via `exec`: this shell must survive gh to unlink the
# scrubbed temps (issue #154) — `exec` replaced it and every temp outlived the
# call. gh's exit status is forwarded unchanged, and the EXIT trap above does
# the unlinking once gh is done.
gh_rc=0
if [ -n "$STDIN_SCRUBBED" ]; then
  "$REAL" "${args[@]}" <"$STDIN_SCRUBBED" || gh_rc=$?
else
  "$REAL" "${args[@]}" || gh_rc=$?
fi
exit "$gh_rc"
