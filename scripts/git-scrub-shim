#!/usr/bin/env bash
# git-scrub-shim — commit/tag messages pass the scrubber before they are
# signed into history (and therefore into pushed refs and PR titles).
#
# Installed by run-dsh-agent.sh at the FRONT of the agent's PATH. Covers
# `git commit/tag/notes -m/--message=` in both the separate-arg and the
# ATTACHED short spelling (`-m"<msg>"` / `-m<msg>` — the value rides in the
# same argv element as the flag, issue #172), and the message-FILE forms
# `-F <file>` / `--file=<file>` / `--file <file>` including the `-` stdin
# spelling (issue #169) again attached (`-F<file>`, issue #172): a message
# read from a file or stdin is still a
# GitHub-bound commit message — it lands in pushed refs and PR titles — so
# the shim scrubs it through the same scrubber (a scrubbed TEMP file is
# handed onward, or stdin is redirected from a scrubbed temp) before the
# real git runs. Only under the message-file subcommands: `-F`/`--file` mean
# something else elsewhere (`git config --file` is a config path; `git
# log`/`git grep -F` is boolean --fixed-strings) and ride untouched.
# Code CONTENTS are not rewritten here — code that must ship is guarded
# upstream (input-side secret scrubbing keeps credentials out of the model's
# authoring context) and downstream (the review stage reads every diff).
#
# Env contract (set by run-dsh-agent.sh; names avoid the
# KEY/PASSWORD/SECRET/TOKEN patterns dsh scrubs from child env):
#   GIT_SCRUB_REAL   absolute path of the real git
#   SCRUB_SCRIPT     absolute path of scrub-output.mjs
#
# Dates are KEPT (DSH_SCRUB_KEEP_DATES=1): a commit message that carries a
# date is authored prose and lands permanently in history — rewriting it at
# commit time corrupts the stored message (ebowwa/FleetTower#301).
#
# Fail-closed (REVIEW.md): if the scrubber cannot run, this shim exits
# non-zero and the real git is NEVER exec'd — an unscrubbed message is not
# signed into history on a scrubber outage. The failure is loud (the
# scrubber's stderr passes through + one context line); the MESSAGE itself
# is never echoed, since it may be the secret. Shell seam: every call site
# captures `msg="$(scrub_or_die ...)" || exit 1` because a bare exit inside
# $( ) kills only the substitution — the status must reach the parent shell
# for the abort to land before the exec.
set -uo pipefail
REAL="${GIT_SCRUB_REAL:?git shim: GIT_SCRUB_REAL not set}"
SCRUB="${SCRUB_SCRIPT:?git shim: SCRUB_SCRIPT not set}"

die() { echo "git-scrub-shim: $*" >&2; exit 1; }

scrub_text() { DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" <<<"$1"; }

scrub_or_die() { # <text> -> scrubbed text on stdout; aborts the shim on failure
  local out
  out="$(scrub_text "$1")" || die "scrubber failed; refusing to write an unscrubbed commit/tag message (fail-closed, REVIEW.md)"
  printf '%s' "$out"
}

scrub_file() { # <path> -> echoes a scrubbed temp file path; aborts the shim on failure
  local out
  out="$(mktemp "${TMPDIR:-/tmp}/git-scrubbed.XXXXXX")"
  if ! DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" <"$1" >"$out"; then
    rm -f "$out"
    die "scrubber failed on $1; refusing to sign an unscrubbed file message into history (fail-closed, REVIEW.md)"
  fi
  printf '%s' "$out"
}

scrub_stdin() { # consumes the shim's own stdin -> scrubbed temp file path on stdout
  local out
  out="$(mktemp "${TMPDIR:-/tmp}/git-scrubbed.XXXXXX")"
  if ! DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" >"$out"; then
    rm -f "$out"
    die "scrubber failed on stdin; refusing to sign an unscrubbed stdin message into history (fail-closed, REVIEW.md)"
  fi
  printf '%s' "$out"
}

# `-F`/`--file` carry a MESSAGE only under some subcommands (commit, tag,
# notes). Elsewhere they mean something else — `git config --file` is a
# config path, `git log`/`git grep -F` is boolean --fixed-strings — and a
# blanket guard would consume-and-rewrite argv those commands never meant as
# a message. Guard only when a message-file subcommand is present; a git
# alias that expands to one of these rides raw (honest limit, see header).
is_msg_cmd() {
  local a
  for a in "$@"; do
    case "$a" in
      commit|tag|notes) return 0;;
    esac
  done
  return 1
}
MSG_CMD=0
is_msg_cmd "$@" && MSG_CMD=1

STDIN_SCRUBBED=""

file_msg_value() { # <flag> <value> — route one message-file value: temp-scrub a
                   # real file, stdin-scrub `-`, else ride through (git errors on it)
  local flag="$1" val="$2"
  if [ "$val" = "-" ]; then
    # git's stdin form: scrub the message once, keep `-` in git's argv, and
    # exec git with stdin redirected from the scrubbed temp (see the exec tail).
    STDIN_SCRUBBED="$(scrub_stdin)" || exit 1
    args+=("$flag" "$val")
  elif [ -f "$val" ]; then
    scrubbed_file="$(scrub_file "$val")" || exit 1
    args+=("$flag" "$scrubbed_file")
  else
    args+=("$flag" "$val")
  fi
}

args=()
while [ $# -gt 0 ]; do
  flag="$1"; shift
  case "$flag" in
    -m|--message)
      if [ $# -gt 0 ]; then
        msg="$(scrub_or_die "$1")" || exit 1
        args+=("$flag" "$msg"); shift
      else
        args+=("$flag")
      fi;;
    -m?*)
      # attached short form (issue #172): git's parse-options takes everything
      # after the flag letter IN THE SAME argv element as the value, so
      # `-m"<msg>"` and `-m<msg>` are one element and used to ride the
      # catch-all raw. Scrub and emit attached again — one argv element, so
      # scrubbed whitespace cannot split into git positionals. A scrubbed
      # value that comes back EMPTY falls back to the separate form: a bare
      # `-m` would otherwise make git consume the NEXT argument as the
      # message.
      msg="$(scrub_or_die "${flag#-m}")" || exit 1
      if [ -n "$msg" ]; then
        args+=("-m$msg")
      else
        args+=("-m" "")
      fi;;
    --message=*)
      key="${flag%%=*}"; val="${flag#*=}"
      msg="$(scrub_or_die "$val")" || exit 1
      args+=("$key=$msg");;
    -F|--file)
      # message-FILE flag (issue #169): a short -F consumes its next argv
      # element as the value even when it starts with `-` (git's parse-options
      # behavior for value-taking short flags), so consume unconditionally —
      # `-` then means stdin, not a flag. Under no message-file subcommand, or
      # with a trailing bare flag, ride through (git errors on it).
      if [ "$MSG_CMD" = 1 ] && [ $# -gt 0 ]; then
        file_msg_value "$flag" "$1"; shift
      else
        args+=("$flag")
      fi;;
    --file=*)
      # equals-form spelling (git's parse-options accepts both) — same
      # routing as the separate-arg form (issue #169)
      if [ "$MSG_CMD" = 1 ]; then
        file_msg_value "${flag%%=*}" "${flag#*=}"
      else
        args+=("$flag")
      fi;;
    -F?*)
      # attached spelling of the message-FILE flag (issue #172): `-F<file>`
      # carries its value the way `-F <file>` does, so route it through the
      # same file_msg_value guard (scrubbed temp path / `-` stdin scrub) and
      # under the same subcommand gate — elsewhere `-F` is not a message
      # (`git log`/`git grep -F` is boolean --fixed-strings) and must ride
      # byte-identical.
      if [ "$MSG_CMD" = 1 ]; then
        file_msg_value "-F" "${flag#-F}"
      else
        args+=("$flag")
      fi;;
    *)
      args+=("$flag");;
  esac
done

# A `-` message-file value was stdin-scrubbed: git still receives `-` in argv,
# but reads the scrubbed temp instead of the raw payload.
if [ -n "$STDIN_SCRUBBED" ]; then
  exec "$REAL" "${args[@]}" <"$STDIN_SCRUBBED"
fi
exec "$REAL" "${args[@]}"
