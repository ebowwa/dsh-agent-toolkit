#!/usr/bin/env bash
# git-scrub-shim — commit/tag messages pass the scrubber before they are
# signed into history (and therefore into pushed refs and PR titles).
#
# Installed by run-dsh-agent.sh at the FRONT of the agent's PATH. Covers
# `git commit/tag/notes/merge/commit-tree -m/--message=` in both the
# separate-arg and the
# ATTACHED short spelling (`-m"<msg>"` / `-m<msg>` — the value rides in the
# same argv element as the flag, issue #172), and the message-FILE forms
# `-F <file>` / `--file=<file>` / `--file <file>` including the `-` stdin
# spelling (issue #169) again attached (`-F<file>`, issue #172): a message
# read from a file or stdin is still a
# GitHub-bound commit message — it lands in pushed refs and PR titles — so
# the shim scrubs it through the same scrubber (a scrubbed TEMP file is
# handed onward, or stdin is redirected from a scrubbed temp) before the
# real git runs, and the temp is unlinked the moment git is done (issue
# #180 — the old `exec` tail left every scrub temp in TMPDIR forever). The
# `-m`/`--message` forms are gated the same way (issue #196): `-m` is not a
# message flag everywhere — `git checkout -m`/`git switch -m` is
# merge-strategy, `git cherry-pick -m <n>` takes a mainline number — and
# outside the message subcommands those values ride byte-identical. Only
# under the message-file subcommands: `-F`/`--file` mean
# something else elsewhere (`git config --file` is a config path; `git
# log`/`git grep -F` is boolean --fixed-strings) and ride untouched.
# Code CONTENTS are not rewritten here — code that must ship is guarded
# upstream (input-side secret scrubbing keeps credentials out of the model's
# authoring context) and downstream (the review stage reads every diff).
#
# Env contract (set by run-dsh-agent.sh; names avoid the
# KEY/PASSWORD/SECRET/TOKEN patterns dsh scrubs from child env):
#   GIT_SCRUB_REAL   absolute path of the real git
#   SCRUB_SCRIPT     absolute path of scrub-output.mjs
#
# Dates are KEPT (DSH_SCRUB_KEEP_DATES=1): a commit message that carries a
# date is authored prose and lands permanently in history — rewriting it at
# commit time corrupts the stored message (ebowwa/FleetTower#301).
#
# Fail-closed (REVIEW.md): if the scrubber cannot run, this shim exits
# non-zero and the real git is NEVER exec'd — an unscrubbed message is not
# signed into history on a scrubber outage. The failure is loud (the
# scrubber's stderr passes through + one context line); the MESSAGE itself
# is never echoed, since it may be the secret. Shell seam: every call site
# captures `msg="$(scrub_or_die ...)" || exit 1` because a bare exit inside
# $( ) kills only the substitution — the status must reach the parent shell
# for the abort to land before git runs.
#
# The BARE-STDIN message form (issue #222): `git commit-tree <tree>` with no
# -m/-F reads the commit message from bare stdin (git's docs: "A commit
# comment is read from stdin"). For bare-stdin message subcommands with no
# message flag in argv, the shim scrubs its inherited stdin once and runs
# git redirected from the scrubbed temp — the same fail-closed path as
# `-F -`. Members whose bare stdin is NOT a message (commit/tag/notes open
# an editor; merge reads none) ride their stdin untouched.
set -uo pipefail
REAL="${GIT_SCRUB_REAL:?git shim: GIT_SCRUB_REAL not set}"
SCRUB="${SCRUB_SCRIPT:?git shim: SCRUB_SCRIPT not set}"

die() { echo "git-scrub-shim: $*" >&2; exit 1; }

# Scrubbed-temp cleanup (issue #180, mirroring the gh shim's #154 fix):
# scrub_file/scrub_stdin mint "${TMPDIR:-/tmp}/git-scrubbed.XXXXXX" temps
# that git reads at run time. The old tail `exec`-ed the real git —
# replacing this shell — so nothing could unlink a temp AFTER git read it:
# every `-F <file>`/`--file=`/`-F -` call left a copy of the post-scrub
# commit message in TMPDIR for the life of the box — on EVERY path, since
# the exec also outlived a non-zero git exit. The shim now stays alive as
# the wrapper (see the run tail): git runs as a child, its exit status is
# forwarded unchanged, and this EXIT trap unlinks every registered temp on
# the way out — success, scrubber abort, or git failure. Registration
# happens in the PARENT shell (file_msg_value), never inside the scrub
# helpers: their callers capture them via $( ), and an array append inside a
# command substitution dies with the subshell.
GIT_SCRUB_TEMPS=()
cleanup_git_scrub_temps() {
  if [ "${#GIT_SCRUB_TEMPS[@]}" -gt 0 ]; then
    rm -f "${GIT_SCRUB_TEMPS[@]}"
  fi
}
trap cleanup_git_scrub_temps EXIT
# An untrapped INT/TERM kills the shell without running the EXIT trap; route
# both through exit so the cleanup lands on Ctrl-C too.
trap 'exit 130' INT
trap 'exit 143' TERM HUP

scrub_text() { DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" <<<"$1"; }

scrub_or_die() { # <text> -> scrubbed text on stdout; aborts the shim on failure
  local out
  out="$(scrub_text "$1")" || die "scrubber failed; refusing to write an unscrubbed commit/tag message (fail-closed, REVIEW.md)"
  printf '%s' "$out"
}

scrub_file() { # <path> -> echoes a scrubbed temp file path; aborts the shim on failure
  local out
  out="$(mktemp "${TMPDIR:-/tmp}/git-scrubbed.XXXXXX")"
  if ! DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" <"$1" >"$out"; then
    rm -f "$out"
    die "scrubber failed on $1; refusing to sign an unscrubbed file message into history (fail-closed, REVIEW.md)"
  fi
  printf '%s' "$out"
}

scrub_stdin() { # consumes the shim's own stdin -> scrubbed temp file path on stdout
  local out
  out="$(mktemp "${TMPDIR:-/tmp}/git-scrubbed.XXXXXX")"
  if ! DSH_SCRUB_KEEP_DATES=1 node "$SCRUB" >"$out"; then
    rm -f "$out"
    die "scrubber failed on stdin; refusing to sign an unscrubbed stdin message into history (fail-closed, REVIEW.md)"
  fi
  printf '%s' "$out"
}

# `-F`/`--file` carry a MESSAGE only under some subcommands (commit, tag,
# notes, merge, commit-tree). Elsewhere they mean something else —
# `git config --file` is a config path, `git log`/`git grep -F` is boolean
# --fixed-strings — and a blanket guard would consume-and-rewrite argv those
# commands never meant as
# a message. Guard only when a message-file subcommand is present IN GIT'S
# ACTUAL SUBCOMMAND POSITION — the first argv element that is not a global
# option or its value. The earlier scan matched the bare WORDS
# commit/tag/notes anywhere in argv (issue #175): a pattern, pathspec, or
# option value equal to one of those words armed the gate and a `-F` in the
# same invocation was consumed-and-rewritten (`git grep -F tag` with a file
# named `tag` lost its PATTERN to a scrub-temp path). A git alias that
# expands to one of these rides raw (honest limit, see header).
subcommand_of() { # echo git's subcommand (first non-global-option element); fail if none
  local a
  while [ $# -gt 0 ]; do
    a="$1"; shift
    case "$a" in
      # value-taking global options: their value is the NEXT element
      -C|-c|--git-dir|--work-tree|--namespace|--exec-path|--super-prefix|--config-env)
        [ $# -gt 0 ] && shift;;
      # attached-value global options: value rides in the same element
      --git-dir=*|--work-tree=*|--namespace=*|--exec-path=*|--super-prefix=*|--config-env=*)
        ;;
      # boolean global flags and any other dash-form: not the subcommand
      -*)
        ;;
      *)
        printf '%s' "$a"; return 0;;
    esac
  done
  return 1
}
MSG_CMD=0
sub="$(subcommand_of "$@")"
case "$sub" in
  commit|tag|notes|merge|commit-tree) MSG_CMD=1;;
esac

# Bare-stdin message subcommands (issue #222): `git commit-tree <tree>` with
# NO -m/-F reads the commit message from bare stdin ("A commit comment is
# read from stdin" — git's own docs), so that entry is a GitHub-bound
# message the shim must scrub, exactly like the `-F -` spelling above. Only
# members whose bare stdin IS a message are listed here: commit/tag/notes
# with no message flag open an EDITOR instead, and merge never reads a
# message from stdin — their stdin (interactive input, plumbing) must ride
# untouched.
BARE_STDIN_MSG=0
case "$sub" in
  commit-tree) BARE_STDIN_MSG=1;;
esac

STDIN_SCRUBBED=""

file_msg_value() { # <flag> <value> — route one message-file value: temp-scrub a
                   # real file, stdin-scrub `-`, else ride through (git errors on it)
  local flag="$1" val="$2"
  if [ "$val" = "-" ]; then
    # git's stdin form: scrub the message once, keep `-` in git's argv, and
    # run git with stdin redirected from the scrubbed temp (see the run tail).
    STDIN_SCRUBBED="$(scrub_stdin)" || exit 1
    GIT_SCRUB_TEMPS+=("$STDIN_SCRUBBED")
    args+=("$flag" "$val")
  elif [ -f "$val" ]; then
    scrubbed_file="$(scrub_file "$val")" || exit 1
    GIT_SCRUB_TEMPS+=("$scrubbed_file")
    args+=("$flag" "$scrubbed_file")
  else
    args+=("$flag" "$val")
  fi
}

MSG_SEEN=0 # any message-flag spelling seen anywhere in argv (issue #222 gate)
args=()
while [ $# -gt 0 ]; do
  flag="$1"; shift
  case "$flag" in
    # any message-flag spelling counts as "a message was given another way"
    # (issue #222): with -m/-F present, bare stdin is NOT the message and
    # must ride untouched
    -m|--message|-m?*|--message=*|-F|--file|--file=*|-F?*) MSG_SEEN=1;;
  esac
  case "$flag" in
    # end-of-options separator (issue #214): git guarantees everything after
    # `--` is a PATHSPEC, never a flag — so a pathspec literally named
    # `-F`/`-m` (a file called `-F` is legal) must ride byte-identical. Stop
    # the message-flag scan at the first `--` and append the remainder
    # verbatim; only argv BEFORE `--` can carry a message flag.
    --)
      args+=("--" "$@")
      break;;
    # -m/--message are gated on the same MSG_CMD as -F/--file (issue #196):
    # they carry a MESSAGE only under commit/tag/notes. Elsewhere -m means
    # something else — `git checkout -m`/`git switch -m` is merge-strategy,
    # `git cherry-pick -m <n>` takes a MAINLINE NUMBER — and the value is not
    # prose: scrubbing it rewrote the branch name / mainline number, and a
    # scrubber outage aborted a command that never carried a message at all
    # (fail-closed applied where there was nothing to protect).
    -m|--message)
      if [ "$MSG_CMD" = 1 ] && [ $# -gt 0 ]; then
        msg="$(scrub_or_die "$1")" || exit 1
        args+=("$flag" "$msg"); shift
      else
        # ride through; still consume the value element (git's parse-options
        # binds it to the flag) so it is never re-parsed as a flag
        args+=("$flag")
        [ $# -gt 0 ] && { args+=("$1"); shift; }
      fi;;
    -m?*)
      # attached short form (issue #172): git's parse-options takes everything
      # after the flag letter IN THE SAME argv element as the value, so
      # `-m"<msg>"` and `-m<msg>` are one element and used to ride the
      # catch-all raw. Scrub and emit attached again — one argv element, so
      # scrubbed whitespace cannot split into git positionals. A scrubbed
      # value that comes back EMPTY falls back to the separate form: a bare
      # `-m` would otherwise make git consume the NEXT argument as the
      # message. Outside a message subcommand the element rides untouched
      # (issue #196) — it is not a message value there.
      if [ "$MSG_CMD" = 1 ]; then
        msg="$(scrub_or_die "${flag#-m}")" || exit 1
        if [ -n "$msg" ]; then
          args+=("-m$msg")
        else
          args+=("-m" "")
        fi
      else
        args+=("$flag")
      fi;;
    --message=*)
      key="${flag%%=*}"; val="${flag#*=}"
      if [ "$MSG_CMD" = 1 ]; then
        msg="$(scrub_or_die "$val")" || exit 1
        args+=("$key=$msg")
      else
        args+=("$flag")
      fi;;
    -F|--file)
      # message-FILE flag (issue #169): a short -F consumes its next argv
      # element as the value even when it starts with `-` (git's parse-options
      # behavior for value-taking short flags), so consume unconditionally —
      # `-` then means stdin, not a flag. Under no message-file subcommand, or
      # with a trailing bare flag, ride through (git errors on it).
      if [ "$MSG_CMD" = 1 ] && [ $# -gt 0 ]; then
        file_msg_value "$flag" "$1"; shift
      else
        args+=("$flag")
      fi;;
    --file=*)
      # equals-form spelling (git's parse-options accepts both) — same
      # routing as the separate-arg form (issue #169)
      if [ "$MSG_CMD" = 1 ]; then
        file_msg_value "${flag%%=*}" "${flag#*=}"
      else
        args+=("$flag")
      fi;;
    -F?*)
      # attached spelling of the message-FILE flag (issue #172): `-F<file>`
      # carries its value the way `-F <file>` does, so route it through the
      # same file_msg_value guard (scrubbed temp path / `-` stdin scrub) and
      # under the same subcommand gate — elsewhere `-F` is not a message
      # (`git log`/`git grep -F` is boolean --fixed-strings) and must ride
      # byte-identical.
      if [ "$MSG_CMD" = 1 ]; then
        file_msg_value "-F" "${flag#-F}"
      else
        args+=("$flag")
      fi;;
    *)
      args+=("$flag");;
  esac
done

# A `-` message-file value was stdin-scrubbed: git still receives `-` in argv,
# but reads the scrubbed temp instead of the raw payload.
#
# Run git as a CHILD, not via `exec`: this shell must survive git to unlink
# the scrubbed temps (issue #180) — `exec` replaced it and every temp
# outlived the call, including when git exited non-zero. git's exit status
# is forwarded unchanged, and the EXIT trap above does the unlinking once
# git is done.
git_rc=0
# Bare-stdin message form (issue #222): a bare-stdin message subcommand with
# NO message flag anywhere in argv and no `-F -` scrub already registered
# reads its message from the shim's inherited stdin — scrub it once and run
# git with stdin redirected from the scrubbed temp (fail-closed: a scrubber
# outage aborts here, REVIEW.md, exactly like the `-F -` path above).
if [ "$BARE_STDIN_MSG" = 1 ] && [ "$MSG_SEEN" = 0 ] && [ -z "$STDIN_SCRUBBED" ]; then
  STDIN_SCRUBBED="$(scrub_stdin)" || exit 1
  GIT_SCRUB_TEMPS+=("$STDIN_SCRUBBED")
fi
if [ -n "$STDIN_SCRUBBED" ]; then
  "$REAL" "${args[@]}" <"$STDIN_SCRUBBED" || git_rc=$?
else
  "$REAL" "${args[@]}" || git_rc=$?
fi
exit "$git_rc"
